# Copy to .env and fill values before running the frontend

# Contact email shown in footer and profile page
VITE_CONTACT_EMAIL=

# Base URL of the backend API (http://127.0.0.1:8000 for local dev)
VITE_API_BASE=http://127.0.0.1:8000

# Vite dev server proxy target — NOT exposed to the browser
# Override if your backend runs on a different port
DEV_API_TARGET=http://127.0.0.1:8000
