# Copy to .env and fill values before running the frontend
# WARNING: 
# These values are exposed to the browser at build time and are NOT SECRET 

# Maptiler API key
# WARNING: 
# Restrict this key in your MapTiler account (by domain/URL) to prevent unauthorized use
VITE_MAPTILER_KEY=

# Base URL of the backend API (http://127.0.0.1:8000 for local dev)
VITE_API_BASE=http://127.0.0.1:8000

# Contact email
VITE_CONTACT_EMAIL=vulpinealicia@gmail.com

# Link to github repo
VITE_REPO_URL=https://github.com/vulpineAlicia/Wispi