# Copy to .env and fill values before running the backend

# Environment: development | production | etc
APP_ENV=development

# OpenWeather API key
OPENWEATHER_API_KEY=

# Allowed frontend origins (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-request upstream timeout (seconds)
HTTP_TIMEOUT_S=6

# Whole-request timeout (seconds) (middleware budget)
REQUEST_TIMEOUT_S=12

# OpenWeather retry policy
OW_TOTAL_BUDGET_S=6
OW_MAX_ATTEMPTS=3

# PostgreSQL
POSTGRES_DB=wispi
POSTGRES_USER=wispi
POSTGRES_PASSWORD=

# Database URL used by the backend
DATABASE_URL=postgresql+asyncpg://wispi:password@db:5432/wispi

# Auth / JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30