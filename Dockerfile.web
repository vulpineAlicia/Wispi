FROM node:22-alpine AS frontend-builder

WORKDIR /app

COPY aq_frontend/package*.json ./aq_frontend/
WORKDIR /app/aq_frontend
RUN npm ci

COPY aq_frontend/ ./
RUN npm run build

FROM caddy:2.10-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-builder /app/aq_frontend/dist /srv

EXPOSE 80
EXPOSE 443